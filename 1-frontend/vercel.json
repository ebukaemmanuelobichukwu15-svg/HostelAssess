{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/student-dashboard", "destination": "/student-dashboard.html" },
    { "source": "/assessment", "destination": "/assessment.html" },
    { "source": "/complaints", "destination": "/complaints.html" },
    { "source": "/admin-dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/admins", "destination": "/admins.html" },
    { "source": "/accept-admin-invite", "destination": "/accept-admin-invite.html" },
    { "source": "/:path*", "destination": "/404.html" }
  ]
}
